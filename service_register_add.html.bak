        function openQuickFillModal(type) {
            currentQuickFillType = type;
            const catalogName = document.getElementById('selected-catalog-name').textContent;
            document.getElementById('check-all-fields').checked = false;
            document.getElementById('selected-count').textContent = '已选 0 项';
            document.getElementById('quick-fill-overlay').classList.remove('opacity-0', 'invisible');
            document.getElementById('quick-fill-modal').classList.remove('opacity-0', 'invisible');
            loadFields(catalogName);
        }

        function closeQuickFillModal() {
            document.getElementById('quick-fill-overlay').classList.add('opacity-0', 'invisible');
            document.getElementById('quick-fill-modal').classList.add('opacity-0', 'invisible');
        }

        function loadFields(catalogName) {
            const fields = catalogFieldsMap[catalogName] || [];
            currentCatalogFields = fields;
            document.getElementById('check-all-fields').checked = false;
            document.getElementById('selected-count').textContent = '已选 0 项';

            const container = document.getElementById('fields-list');
            if (fields.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10 text-[#909399] text-sm">
                        <i class="fa-solid fa-folder-open text-2xl mb-2 block opacity-30"></i>
                        暂无字段数据
                    </div>
                `;
                return;
            }

            container.innerHTML = `
                <table class="w-full text-sm table-fixed">
                    <thead>
                        <tr class="bg-gray-50 sticky top-0">
                            <th class="w-10 py-2.5 text-center font-medium text-[#606266]">序号</th>
                            <th class="px-3 py-2.5 text-left font-medium text-[#606266]">字段名称</th>
                            <th class="px-3 py-2.5 text-left font-medium text-[#606266]">字段描述</th>
                            <th class="w-14 py-2.5 text-center font-medium text-[#606266]">选择</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${fields.map((field, index) => `
                            <tr class="border-b border-gray-100 hover:bg-blue-50/50 transition-colors">
                                <td class="py-2.5 text-center text-[#909399]">${index + 1}</td>
                                <td class="px-3 py-2.5 text-[#303133] font-mono text-xs">${field.name}</td>
                                <td class="px-3 py-2.5 text-[#606266]">${field.desc}</td>
                                <td class="py-2.5 text-center">
                                    <input type="checkbox" class="field-checkbox rounded text-[#1c7ffd]" data-index="${index}">
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;

            document.querySelectorAll('#fields-list tbody tr').forEach((row, index) => {
                row.addEventListener('click', (e) => {
                    if (e.target.tagName !== 'INPUT') {
                        const cb = row.querySelector('.field-checkbox');
                        cb.checked = !cb.checked;
                        updateSelectedCount();
                    }
                });
            });
        }

        function toggleAllFields() {
            const checkAll = document.getElementById('check-all-fields').checked;
            document.querySelectorAll('.field-checkbox').forEach(cb => {
                cb.checked = checkAll;
            });
            updateSelectedCount();
        }

        function updateSelectedCount() {
            const checkboxes = document.querySelectorAll('.field-checkbox');
            const checked = document.querySelectorAll('.field-checkbox:checked').length;
            document.getElementById('selected-count').textContent = `已选 ${checked} 项`;
            const checkAll = document.getElementById('check-all-fields');
            if (checkboxes.length > 0 && checked === checkboxes.length) {
                checkAll.checked = true;
            } else {
                checkAll.checked = false;
            }
        }

        function doQuickFill() {
            const checkedBoxes = document.querySelectorAll('.field-checkbox:checked');
            if (checkedBoxes.length === 0) {
                alert('请至少选择一个字段');
                return;
            }

            const selected = [];
            checkedBoxes.forEach(cb => {
                const index = parseInt(cb.dataset.index);
                selected.push(currentCatalogFields[index]);
            });

            closeQuickFillModal();

            if (currentQuickFillType === 'request') {
                fillRequestQuick(selected);
            } else if (currentQuickFillType === 'response') {
                fillResponseQuick(selected);
            }
        }

        function fillRequestQuick(fields) {
            const tbody = document.getElementById('requestParamsBody');
            const order = tbody.querySelectorAll('tr:not([style*="display: none"])').length;
            let html = fields.map((field, i) => `
                <tr class="border-b border-gray-100">
                    <td class="py-3 px-4"><input type="text" value="${field.name}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><input type="text" value="${field.desc}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4">
                        <select class="w-full border border-gray-200 rounded px-2 py-1 text-xs">
                            <option>body</option>
                            <option>query</option>
                            <option>header</option>
                        </select>
                    </td>
                    <td class="py-3 px-4">
                        <select class="w-full border border-gray-200 rounded px-2 py-1 text-xs">
                            <option>否</option>
                            <option>是</option>
                        </select>
                    </td>
                    <td class="py-3 px-4"><input type="text" value="${order + i + 1}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs w-16 mx-auto"></td>
                    <td class="py-3 px-4"><input type="text" placeholder="参数默认值" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4 text-[#1c7ffd]">
                        <a href="#" onclick="deleteRow(this)" class="hover:underline">删除</a>
                    </td>
                </tr>
            `).join('');

            if (tbody.querySelector('td[colspan]')) {
                tbody.innerHTML = html;
            } else {
                tbody.insertAdjacentHTML('beforeend', html);
            }
        }

        function fillResponseQuick(fields) {
            const tbody = document.getElementById('responseParamsBody');
            let html = fields.map(field => `
                <tr class="border-b border-gray-100">
                    <td class="py-3 px-4"><input type="text" value="${field.name}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><input type="text" value="${field.desc}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4 text-[#1c7ffd]">
                        <a href="#" onclick="deleteRow(this)" class="hover:underline">删除</a>
                    </td>
                </tr>
            `).join('');

            if (tbody.querySelector('td[colspan]')) {
                tbody.innerHTML = html;
            } else {
                tbody.insertAdjacentHTML('beforeend', html);
            }
        }

        // ============== 全局智能填写（悬浮按钮+抽屉） ==============
        let lastSmartAnswer = null;

        function openGlobalSmartFill() {
            document.getElementById('global-smart-overlay').classList.remove('opacity-0', 'invisible');
            document.getElementById('global-smart-drawer').classList.remove('translate-x-full');
            document.body.style.overflow = 'hidden';
        }

        function closeGlobalSmartFill() {
            document.getElementById('global-smart-overlay').classList.add('opacity-0', 'invisible');
            document.getElementById('global-smart-drawer').classList.add('translate-x-full');
            document.body.style.overflow = '';
        }

        function quickAsk(id) {
            const map = {
                1: '帮我填写一个「身份证号查询公民基本信息」的接口服务：POST方式，请求参数为身份证号id_card(必填，string，body)，返回参数request_id、data.name(姓名)、data.gender(性别)、data.age(年龄)、data.birthday(出生日期)、data.address(户籍地址)，错误代码400参数错误、401未授权、500服务器错误',
                2: '帮我填写「统一社会信用代码查询企业工商信息」接口服务：GET方式，请求参数credit_code(必填，string，query)，返回企业名称、法人、注册资本、成立日期、注册地址、经营范围，错误代码400、404未找到、500',
                3: '帮我填写「手机号查询用户基础信息」接口服务：POST方式，请求参数phone(必填，header中app_id和app_secret为固定常量参数，body中phone)，返回用户ID、昵称、头像、性别、注册时间、会员等级，错误代码400参数错误、403无权限、429调用超限'
            };
            const val = map[id] || '';
            document.getElementById('global-smart-input').value = val;
            sendGlobalSmartMsg();
        }

        function handleGlobalSmartFile(e) {
            const files = Array.from(e.target.files || []);
            if (!files.length) return;
            const preview = document.getElementById('global-smart-preview');
            const html = files.map(f => {
                let icon = 'fa-file-lines text-gray-500';
                if (/\.xlsx?|\.csv$/i.test(f.name)) icon = 'fa-file-excel text-green-600';
                else if (/\.docx?$/i.test(f.name)) icon = 'fa-file-word text-blue-600';
                else if (/\.pdf$/i.test(f.name)) icon = 'fa-file-pdf text-red-500';
                else if (/\.json|\.ya?ml$/i.test(f.name)) icon = 'fa-file-code text-yellow-600';
                else if (/\.txt$/i.test(f.name)) icon = 'fa-file-alt text-indigo-500';
                const size = f.size > 1048576 ? (f.size/1048576).toFixed(2)+'MB' : (f.size/1024).toFixed(1)+'KB';
                return `<div class="flex items-center justify-between px-3 py-2 border border-gray-200 rounded-lg bg-gray-50 mb-2 last:mb-0">
                    <div class="flex items-center gap-2.5 min-w-0 flex-1">
                        <i class="fa-solid ${icon} text-lg"></i>
                        <div class="min-w-0 flex-1">
                            <div class="text-sm text-[#303133] truncate">${f.name}</div>
                            <div class="text-xs text-[#909399]">${size} · 等待AI解析</div>
                        </div>
                    </div>
                    <button type="button" onclick="this.closest('#global-smart-preview').querySelectorAll('div.flex.items-center.justify-between').length<=1?(document.getElementById('global-smart-preview').classList.add('hidden'),document.getElementById('global-smart-preview').innerHTML=''):this.closest('div.flex.items-center.justify-between').remove();document.getElementById('global-smart-upload').value='';"
                        class="w-7 h-7 rounded-full hover:bg-white text-[#909399] hover:text-red-500 shrink-0 ml-2 flex items-center justify-center">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>`;
            }).join('');
            preview.innerHTML = html;
            preview.classList.remove('hidden');
            addMsgRight('📄 已上传接口文档：' + files.map(f=>f.name).join('、') + '<br>点击发送按钮，AI自动解析文件内容并生成推荐的服务注册信息～');
        }

        function addMsgRight(text) {
            const msgs = document.getElementById('global-smart-messages');
            const d = document.createElement('div');
            d.className = 'flex items-start gap-3 justify-end';
            d.innerHTML = `<div class="max-w-[82%]">
                <div class="bg-[#1c7ffd] text-white rounded-2xl rounded-tr-md px-4 py-3 text-sm leading-relaxed">${text}</div>
            </div>
            <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=yiyun&backgroundColor=b6e3f4" class="w-8 h-8 rounded-full">
            </div>`;
            msgs.appendChild(d);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function addMsgLeft(html) {
            const msgs = document.getElementById('global-smart-messages');
            const d = document.createElement('div');
            d.className = 'flex items-start gap-3';
            d.innerHTML = `<div class="w-10 h-10 rounded-full gradient-bg flex items-center justify-center shrink-0">
                <i class="fa-solid fa-robot text-white text-base"></i>
            </div><div class="flex-1">${html}</div>`;
            msgs.appendChild(d);
            msgs.scrollTop = msgs.scrollHeight;
            return d;
        }

        function handleGlobalSmartKeydown(e) {
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                e.preventDefault();
                sendGlobalSmartMsg();
            }
        }

        function sendGlobalSmartMsg() {
            const input = document.getElementById('global-smart-input');
            const val = (input.value || '').trim();
            const hasFile = document.getElementById('global-smart-preview') &&
                          !document.getElementById('global-smart-preview').classList.contains('hidden');
            if (!val && !hasFile) return;

            if (val) addMsgRight(val.replace(/\n/g, '<br>'));
            input.value = '';

            const placeholder = addMsgLeft(`<div class="bg-gray-100 rounded-2xl rounded-tl-md px-4 py-3.5 text-sm text-[#303133] leading-relaxed">
                <i class="fa-solid fa-spinner fa-spin mr-2 text-[#1c7ffd]"></i>AI正在分析，请稍候...
            </div>`);

            setTimeout(() => {
                const summary = mockSmartAnswer(val || '接口文档解析');
                placeholder.querySelector('div.flex-1 > div')?.remove();
                lastSmartAnswer = summary;
                const bubble = placeholder.querySelector('div.flex-1');
                bubble.innerHTML = buildAnswerBubble(summary);
                document.getElementById('apply-fill-btn')?.classList.remove('hidden');
            }, 900);
        }

        function mockSmartAnswer(text) {
            const t = text.toLowerCase();
            let svcName = '自定义信息查询接口';
            let svcType = '查询服务';
            let callMethod = 'GET';
            if (/身份证|公民|id_card|人口|个人/.test(t)) { svcName = '身份证号查询公民基本信息接口'; svcType = '查询服务'; callMethod = 'POST'; }
            else if (/企业|工商|信用代码|credit/.test(t)) { svcName = '统一社会信用代码查询企业工商信息接口'; svcType = '查询服务'; callMethod = 'GET'; }
            else if (/手机|phone|用户/.test(t)) { svcName = '手机号查询用户基础信息接口'; svcType = '查询服务'; callMethod = 'POST'; }
            else if (/新增|创建|保存|insert|post/.test(t)) { svcType = '新增服务'; callMethod = 'POST'; }
            else if (/修改|更新|update|put/.test(t)) { svcType = '更新服务'; callMethod = 'PUT'; }
            else if (/删除|delete|移除/.test(t)) { svcType = '删除服务'; callMethod = 'DELETE'; }
            else if (/post/.test(t)) callMethod = 'POST';

            const defaultReq = [
                { name:'id_card', desc:'身份证号', loc:'body', req:'是', order:1, def:'' },
                { name:'name', desc:'姓名', loc:'body', req:'否', order:2, def:'' }
            ];
            const defaultResp = [
                { name:'request_id', desc:'请求追踪ID' },
                { name:'data.name', desc:'姓名' },
                { name:'data.id_card', desc:'身份证号' }
            ];
            const defaultErr = [
                { code:'400', desc:'参数错误' },
                { code:'401', desc:'未授权' },
                { code:'500', desc:'服务器内部错误' }
            ];
            const defaultFixed = [
                { name:'app_id', desc:'应用ID', loc:'header', order:1, def:'APP-SERVICE-001' },
                { name:'app_secret', desc:'应用密钥', loc:'header', order:2, def:'xxxx-secret' }
            ];

            if (/企业|工商|credit/.test(t)) {
                return {
                    svcName, svcType, callMethod,
                    tags:['工商','企业','查询'],
                    desc:'根据统一社会信用代码查询企业工商登记基本信息，适用于企业身份核验、信用监管等场景。',
                    timeOut: 10,
                    limitDay: 10000,
                    req: [
                        { name:'credit_code', desc:'统一社会信用代码', loc:'query', req:'是', order:1, def:'' },
                        { name:'keyword', desc:'企业名称关键字', loc:'query', req:'否', order:2, def:'' }
                    ],
                    fixed: defaultFixed,
                    resp: [
                        { name:'request_id', desc:'请求追踪ID' },
                        { name:'data.company_name', desc:'企业名称' },
                        { name:'data.legal_person', desc:'法定代表人' },
                        { name:'data.register_capital', desc:'注册资本' },
                        { name:'data.register_date', desc:'成立日期' },
                        { name:'data.register_address', desc:'注册地址' },
                        { name:'data.business_scope', desc:'经营范围' }
                    ],
                    err: [
                        { code:'400', desc:'请求参数错误，请检查credit_code格式' },
                        { code:'404', desc:'未查询到该信用代码对应企业信息' },
                        { code:'500', desc:'服务器内部错误' }
                    ]
                };
            }
            if (/身份证|公民|id_card|人口/.test(t)) {
                return {
                    svcName, svcType, callMethod,
                    tags: ['人口','个人','查询'],
                    desc: '根据身份证号查询公民基本信息，用于政务服务、核验类场景。',
                    timeOut: 8, limitDay: 5000,
                    req: [{ name:'id_card', desc:'身份证号码', loc:'body', req:'是', order:1, def:'' }],
                    fixed: defaultFixed,
                    resp: [
                        { name:'request_id', desc:'请求追踪ID' },
                        { name:'data.name', desc:'姓名' },
                        { name:'data.gender', desc:'性别' },
                        { name:'data.nation', desc:'民族' },
                        { name:'data.birthday', desc:'出生日期' },
                        { name:'data.address', desc:'户籍地址' },
                        { name:'data.id_card', desc:'身份证号' }
                    ],
                    err: defaultErr
                };
            }
            if (/手机|phone|用户/.test(t)) {
                return {
                    svcName, svcType, callMethod,
                    tags: ['用户','移动','查询'],
                    desc: '根据手机号查询注册用户基础信息，适用于会员体系、营销服务等场景。',
                    timeOut: 6, limitDay: 20000,
                    req: [{ name:'phone', desc:'手机号', loc:'body', req:'是', order:1, def:'' }],
                    fixed: [
                        { name:'app_id', desc:'应用ID', loc:'header', order:1, def:'APP-USER-001' },
                        { name:'access_token', desc:'访问令牌', loc:'header', order:2, def:'${token}' }
                    ],
                    resp: [
                        { name:'request_id', desc:'请求追踪ID' },
                        { name:'data.user_id', desc:'用户ID' },
                        { name:'data.nickname', desc:'昵称' },
                        { name:'data.avatar', desc:'头像' },
                        { name:'data.gender', desc:'性别' },
                        { name:'data.register_date', desc:'注册时间' },
                        { name:'data.vip_level', desc:'会员等级' }
                    ],
                    err: [
                        { code:'400', desc:'手机号参数错误' },
                        { code:'401', desc:'未授权或令牌无效' },
                        { code:'403', desc:'无访问权限' },
                        { code:'429', desc:'接口调用超限' },
                        { code:'500', desc:'服务器内部错误' }
                    ]
                };
            }
            return { svcName, svcType, callMethod,
                tags:['自定义','API'], desc:'基于描述/文档自动解析生成的服务信息，请检查修改。',
                timeOut: 10, limitDay: 10000,
                req: defaultReq, fixed: defaultFixed, resp: defaultResp, err: defaultErr };
        }

        function buildAnswerBubble(s) {
            const tagHtml = (s.tags||[]).map(x=>`<span class="px-2 py-0.5 bg-blue-50 text-[#1c7ffd] text-xs rounded mr-1 mb-1 inline-block">${x}</span>`).join('');
            return `<div class="bg-gray-100 rounded-2xl rounded-tl-md px-4 py-4 text-sm text-[#303133] leading-relaxed">
                ✅ 已为您生成「<b>${s.svcName}</b>」的推荐信息，可直接应用到表单：<br><br>
                <div class="space-y-2 bg-white rounded-lg border border-gray-200 p-3 text-[13px]">
                    <div><span class="text-[#909399] w-24 inline-block shrink-0">服务名称：</span><b>${s.svcName}</b></div>
                    <div><span class="text-[#909399] w-24 inline-block shrink-0">服务类型：</span>${s.svcType}</div>
                    <div><span class="text-[#909399] w-24 inline-block shrink-0">调用方式：</span><code class="px-1.5 py-0.5 bg-blue-50 text-[#1c7ffd] text-xs rounded">${s.callMethod}</code></div>
                    <div><span class="text-[#909399] w-24 inline-block shrink-0 align-top">标签：</span>${tagHtml || '-'}</div>
                    <div><span class="text-[#909399] w-24 inline-block shrink-0 align-top">服务描述：</span>${s.desc}</div>
                    <div><span class="text-[#909399] w-24 inline-block shrink-0">超时时间：</span>${s.timeOut}秒 / 单日限 ${s.limitDay}次</div>
                </div>
                <div class="grid grid-cols-4 gap-3 mt-4">
                    <div class="col-span-2 bg-white rounded-lg border border-gray-200 p-3 text-xs">
                        <div class="flex items-center gap-1 mb-2 text-[#1c7ffd] font-medium"><i class="fa-solid fa-arrow-down w-3.5"></i>请求参数 <span class="text-[#909399] font-normal">(${s.req.length})</span></div>
                        <div class="space-y-1 text-[#606266]">${s.req.map(r=>`
                            <div class="flex justify-between gap-2"><span class="truncate">${r.name}</span><span class="truncate text-[#909399]">${r.desc}</span></div>`).join('')}
                        </div>
                    </div>
                    <div class="bg-white rounded-lg border border-gray-200 p-3 text-xs">
                        <div class="flex items-center gap-1 mb-2 text-[#36c2aa] font-medium"><i class="fa-solid fa-wrench w-3.5"></i>常量参数 <span class="text-[#909399] font-normal">(${s.fixed.length})</span></div>
                        <div class="space-y-1 text-[#606266]">${s.fixed.map(f=>`
                            <div class="flex justify-between gap-2"><span class="truncate">${f.name}</span><span class="truncate text-[#909399]">${f.desc}</span></div>`).join('')}
                        </div>
                    </div>
                    <div class="col-span-2 bg-white rounded-lg border border-gray-200 p-3 text-xs">
                        <div class="flex items-center gap-1 mb-2 text-indigo-600 font-medium"><i class="fa-solid fa-arrow-up w-3.5"></i>返回参数 <span class="text-[#909399] font-normal">(${s.resp.length})</span></div>
                        <div class="grid grid-cols-2 gap-x-3 gap-y-1 text-[#606266]">${s.resp.map(r=>`
                            <div class="flex justify-between gap-2"><span class="truncate">${r.name}</span><span class="truncate text-[#909399]">${r.desc}</span></div>`).join('')}
                        </div>
                    </div>
                    <div class="col-span-2 bg-white rounded-lg border border-gray-200 p-3 text-xs">
                        <div class="flex items-center gap-1 mb-2 text-red-500 font-medium"><i class="fa-solid fa-triangle-exclamation w-3.5"></i>错误代码 <span class="text-[#909399] font-normal">(${s.err.length})</span></div>
                        <div class="grid grid-cols-3 gap-x-3 gap-y-1 text-[#606266]">${s.err.map(e=>`
                            <div class="flex items-center gap-2"><code class="px-1.5 py-0.5 bg-red-50 text-red-500 rounded text-[11px]">${e.code}</code><span class="truncate">${e.desc}</span></div>`).join('')}
                        </div>
                    </div>
                </div>
                <div class="mt-3 text-xs text-[#909399]">点击右上角「<b class="text-[#303133]">应用AI填写到表单</b>」按钮，一键填充以下内容～</div>
            </div>`;
        }

        function fillWithLastAnswer() {
            const s = lastSmartAnswer;
            if (!s) { alert('请先让AI生成推荐内容再应用～'); return; }

            const safeSet = (id, val) => { const el = document.getElementById(id); if (el) el.value = val ?? ''; };
            safeSet('service-name', s.svcName);
            const typeEl = document.getElementById('service-type');
            if (typeEl) {
                const v = s.svcType === '新增服务' ? '新增' : s.svcType === '更新服务' ? '更新' : s.svcType === '删除服务' ? '删除' : '查询';
                typeEl.value = v;
            }
            safeSet('service-method', s.callMethod);
            safeSet('service-desc', s.desc);
            safeSet('service-timeout', s.timeOut);
            safeSet('service-daily-limit', s.limitDay);

            if (s.req && s.req.length) {
                const tb = document.getElementById('requestParamsBody');
                tb.innerHTML = s.req.map((r,i)=>`<tr class="border-b border-gray-100">
                    <td class="py-3 px-4"><input type="text" value="${r.name}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><input type="text" value="${r.desc}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><select class="w-full border border-gray-200 rounded px-2 py-1 text-xs">
                        ${['body','query','header','path'].map(x=>`<option ${r.loc===x?'selected':''}>${x}</option>`).join('')}</select></td>
                    <td class="py-3 px-4"><select class="w-full border border-gray-200 rounded px-2 py-1 text-xs">
                        <option ${r.req==='是'?'selected':''}>是</option>
                        <option ${r.req==='否'?'selected':''}>否</option></select></td>
                    <td class="py-3 px-4"><input type="text" value="${r.order ?? (i+1)}" class="w-16 mx-auto border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><input type="text" value="${r.def??''}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4 text-[#1c7ffd]"><a href="#" onclick="deleteRow(this)" class="hover:underline">删除</a></td>
                </tr>`).join('');
            }
            if (s.fixed && s.fixed.length) {
                const tb = document.getElementById('fixedParamsBody');
                tb.innerHTML = s.fixed.map((r,i)=>`<tr class="border-b border-gray-100">
                    <td class="py-3 px-4"><input type="text" value="${r.name}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><input type="text" value="${r.desc}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><select class="w-full border border-gray-200 rounded px-2 py-1 text-xs">
                        ${['header','body','query','path'].map(x=>`<option ${r.loc===x?'selected':''}>${x}</option>`).join('')}</select></td>
                    <td class="py-3 px-4"><input type="text" value="${r.order ?? (i+1)}" class="w-16 mx-auto border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><input type="text" value="${r.def??''}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4 text-[#1c7ffd]"><a href="#" onclick="deleteRow(this)" class="hover:underline">删除</a></td>
                </tr>`).join('');
            }
            if (s.resp && s.resp.length) {
                const tb = document.getElementById('responseParamsBody');
                tb.innerHTML = s.resp.map(r=>`<tr class="border-b border-gray-100">
                    <td class="py-3 px-4"><input type="text" value="${r.name}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><input type="text" value="${r.desc}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4 text-[#1c7ffd]"><a href="#" onclick="deleteRow(this)" class="hover:underline">删除</a></td>
                </tr>`).join('');
            }
            if (s.err && s.err.length) {
                const tb = document.getElementById('errorCodesBody');
                tb.innerHTML = s.err.map(e=>`<tr class="border-b border-gray-100">
                    <td class="py-3 px-4"><input type="text" value="${e.code}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4"><input type="text" value="${e.desc}" class="w-full border border-gray-200 rounded px-2 py-1 text-xs"></td>
                    <td class="py-3 px-4 text-[#1c7ffd]"><a href="#" onclick="deleteRow(this)" class="hover:underline">删除</a></td>
                </tr>`).join('');
            }

            closeGlobalSmartFill();
            toast('✅ AI已自动填写以下内容：服务名称/类型/调用方式/描述 → 请求参数/常量参数/返回参数/错误代码');
        }

        function toast(msg) {
            let el = document.getElementById('ai-fill-toast');
            if (!el) {
                el = document.createElement('div');
                el.id = 'ai-fill-toast';
                el.className = 'fixed top-6 left-1/2 -translate-x-1/2 z-[999] px-5 py-3 bg-[#303133] text-white text-sm rounded-lg shadow-2xl opacity-0 translate-y-[-10px] transition-all duration-300 max-w-[560px] text-center';
                document.body.appendChild(el);
            }
            el.textContent = msg;
            requestAnimationFrame(() => { el.classList.remove('opacity-0','translate-y-[-10px]'); });
            clearTimeout(toast._t);
            toast._t = setTimeout(() => el.classList.add('opacity-0','translate-y-[-10px]'), 3200);
        }
    </script>
</body>
</html>